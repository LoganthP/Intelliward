# Backend URL and the shared internal token (must equal INTERNAL_TOKEN in backend/.env)
API_URL=http://127.0.0.1:8000
INTERNAL_TOKEN=change-me-worker-token
# auto | yolo | fallback     (auto = YOLOv8+ByteTrack if ultralytics is installed)
DETECTOR=auto
# auto | insightface | opencv
FACE_BACKEND=auto
YOLO_WEIGHTS=yolov8n.pt
# cpu | cuda | auto
DEVICE=auto
# Force every camera to use the synthetic scenario (no webcam or AI models needed)
SIMULATE_ALL=false
STREAM_FPS=8
STREAM_WIDTH=960

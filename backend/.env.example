# ---- IntelliWard backend configuration ----
# SQLite works out of the box (zero setup). For PostgreSQL (recommended for the final submission):
#   docker compose up -d postgres
#   DATABASE_URL=postgresql+psycopg://intelliward:intelliward@localhost:5432/intelliward
DATABASE_URL=sqlite:///../data/intelliward.db

# Change these before any shared deployment. INTERNAL_TOKEN must match vision-worker/.env
JWT_SECRET=change-me-intelliward-jwt-secret
INTERNAL_TOKEN=change-me-worker-token
# Fernet key that encrypts face embeddings at rest. Empty = auto-generate data/secret.key
EMBEDDING_KEY=

# Independent anchor store (append-only JSONL kept outside the main database)
ANCHOR_DIR=../data/anchors
DATA_DIR=../data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUDIT_BATCH_SIZE=25
AUDIT_BATCH_MAX_AGE_SECONDS=60
